    {
      "type": "timeseries",
      "title": "커넥션 획득 시간 / 타임아웃",
      "description": "타임아웃(hikaricp_connections_timeout_total)이 한 번이라도 늘면 DbConnectionAcquireTimeout",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (rate(hikaricp_connections_acquire_seconds_sum{application=\"auction-engine\"}[$__rate_interval]) / rate(hikaricp_connections_acquire_seconds_count{application=\"auction-engine\"}[$__rate_interval]))",
          "range": true,
          "legendFormat": "평균 획득 시간 {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
