      "title": "커넥션 사용 현황",
      "description": "사용 중이 최대에 붙고 대기가 생기면 DbConnectionPoolSaturated",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (hikaricp_connections_active{application=\"auction-engine\"})",
