// Grafana Alloy 설정: Docker 컨테이너 로그를 수집해 Loki로 보낸다.
// (Promtail은 2026-03-02 지원 종료되어 후속 수집기인 Alloy를 사용한다)

// 1) Docker 소켓으로 실행 중인 컨테이너 목록을 찾는다.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 2) Loki에서 검색할 때 쓸 라벨을 붙인다.
//    service: compose 서비스 이름 (auction-engine, realtime-relay, frontend, db, redis ...)
//    container: 컨테이너 이름
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

// 3) 컨테이너의 표준 출력 로그를 읽어 Loki로 전달한다.
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.local.receiver]
}

// 4) Loki로 전송
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// 5) 트레이스: 앱(엔진, relay)이 OpenTelemetry(OTLP)로 보낸 트레이스를 받아 Tempo로 전달한다.
//    gRPC(4317), HTTP(4318) 둘 다 연다. 보내는 쪽 SDK마다 기본 프로토콜이 달라서
//    (OTel Java 에이전트 2.x 기본값은 HTTP) 어느 쪽으로 보내도 받을 수 있게 한다.
otelcol.receiver.otlp "apps" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.traces.input]
  }
}

// 6) 트레이스를 모아서(batch) 한 번에 보낸다 (요청 수를 줄이기 위해)
otelcol.processor.batch "traces" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// 7) Tempo로 전송 (compose 내부 통신이라 TLS 없이)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}
